{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "https://www.spokum.space/",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "neorbital.vercel.app"
        }
      ],
      "destination": "https://www.spokum.space/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "neorbital.vercel.app"
        }
      ],
      "destination": "https://www.spokum.space/:path*",
      "statusCode": 301
    }
  ]
}
